# Copy this file to .env and fill in your values.
# .env is gitignored — never commit actual secrets.
#
# These values must match docker-compose.yml.

POSTGRES_DB=riw
POSTGRES_USER=riw_user
POSTGRES_PASSWORD=riw_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Phase 4 — LLM provider (Google Gemini)
GOOGLE_API_KEY=your-google-api-key-here
# Optional: override the default model
# LLM_MODEL=gemini-3.6-flash

# Phase 8 — Default LLM provider (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5
